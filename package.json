{
  "name": "react-patternify",
  "version": "0.1.3",
  "description": "Animated canvas background patterns for React",
  "author": "Kaveh Karami",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KavehKarami/react-patternify"
  },
  "homepage": "https://github.com/KavehKarami/react-patternify#readme",
  "bugs": {
    "url": "https://github.com/KavehKarami/react-patternify/issues"
  },
  "keywords": [
    "react",
    "background",
    "pattern",
    "tetris",
    "canvas",
    "animation"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
